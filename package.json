{
  "name": "@kittycorn-labs/smart-order-router",
  "version": "5.0.0",
  "description": "Uniswap Smart Order Router",
  "main": "build/main/index.js",
  "typings": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crown-Labs/smart-order-router"
  },
  "license": "GPL",
  "keywords": [],
  "scripts": {
    "compile-v3-types": "typechain --target ethers-v5 --out-dir src/types/v3 'abi/v3/*.json'",
    "compile-v2-types": "typechain --target ethers-v5 --out-dir src/types/v2 'abi/v2/*.json'",
    "compile-router": "typechain --target ethers-v5 --out-dir src/types/other 'abi/other/*.json'",
    "compile-external-types": "typechain --target ethers-v5 --out-dir src/types/other 'src/abis/**/*.json'",
    "build": "npm run clean && npm run generate-types && run-p build:main build:module",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "fix:lint": "eslint src --ext .ts --fix",
    "test": "jest test/unit",
    "integ-test": "npm run check:fork",
    "prepare": "husky",
    "npm:publish": "node scripts/pack.js --publish",
    "dev": "ts-node cli/kittycorn.ts",
    "generate-types": "run-s compile-v3-types compile-v2-types compile-router compile-external-types",
    "typecheck:cli": "tsc -p tsconfig.cli.json --noEmit --incremental false",
    "check:fork": "ts-node cli/check-kittycorn.ts",
    "pack:release": "node scripts/pack.js",
    "check:abis": "node scripts/abis.js",
    "check:liquidity": "ts-node cli/check-liquidity.ts",
    "clean": "node -e \"for (const dir of ['build', 'src/types']) require('fs').rmSync(dir, {recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@kittycorn-labs/router-sdk": "file:../sdks/.sdk-packages/kittycorn-labs-router-sdk-2.0.0.tgz",
    "@kittycorn-labs/sdk-core": "file:../sdks/.sdk-packages/kittycorn-labs-sdk-core-2.0.0.tgz",
    "@kittycorn-labs/universal-router-sdk": "file:../sdks/.sdk-packages/kittycorn-labs-universal-router-sdk-2.0.0.tgz",
    "@kittycorn-labs/v2-sdk": "file:../sdks/.sdk-packages/kittycorn-labs-v2-sdk-2.0.0.tgz",
    "@kittycorn-labs/v3-sdk": "file:../sdks/.sdk-packages/kittycorn-labs-v3-sdk-2.0.0.tgz",
    "@kittycorn-labs/v4-sdk": "file:../sdks/.sdk-packages/kittycorn-labs-v4-sdk-2.0.0.tgz",
    "@types/brotli": "^1.3.4",
    "@uniswap/default-token-list": "^11.13.0",
    "@uniswap/permit2-sdk": "1.4.1",
    "@uniswap/token-lists": "1.0.0-beta.31",
    "async-retry": "^1.3.1",
    "await-timeout": "^1.1.1",
    "axios": "^1.21.1",
    "brotli": "^1.3.3",
    "bunyan": "^1.8.15",
    "bunyan-blackhole": "^1.1.1",
    "ethers": "^5.8.0",
    "graphql": "^15.5.0",
    "graphql-request": "^3.4.0",
    "lodash": "^4.18.1",
    "mnemonist": "^0.38.3",
    "node-cache": "^5.1.2",
    "stats-lite": "^2.2.0"
  },
  "devDependencies": {
    "@ethersproject/providers": "^5.4.0",
    "@typechain/ethers-v5": "^7.0.1",
    "@types/async-retry": "^1.4.4",
    "@types/await-timeout": "^0.3.1",
    "@types/bunyan": "^1.8.6",
    "@types/bunyan-blackhole": "^0.2.2",
    "@types/jest": "^27.0.0",
    "@types/jest-sinon": "^1.0.2",
    "@types/lodash": "^4.14.168",
    "@types/node": "^18.7.16",
    "@types/sinon": "^10.0.2",
    "@types/stats-lite": "^2.2.0",
    "@typescript-eslint/eslint-plugin": "^4.0.1",
    "@typescript-eslint/parser": "^4.0.1",
    "dotenv": "^10.0.0",
    "eslint": "^7.8.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.22.0",
    "husky": "^9.1.5",
    "jest": "^27.0.6",
    "jest-circus": "^27.5.1",
    "jest-expect-message": "^1.0.2",
    "jest-mock": "^27.0.6",
    "jest-sinon": "^1.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.1.1",
    "prettier-plugin-organize-imports": "^2.1.0",
    "sinon": "^11.1.2",
    "ts-jest": "^27.0.4",
    "ts-node": "^10.8.1",
    "typechain": "^5.0.0",
    "typescript": "4.9.5"
  },
  "peerDependencies": {
    "jsbi": "^3.2.0"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "prettier": {
    "singleQuote": true
  },
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "@ethersproject/providers": {
      "ws": "8.21.0"
    }
  }
}
