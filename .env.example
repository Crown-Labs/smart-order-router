# Base Sepolia RPC used by make quote (no private key required).
JSON_RPC_PROVIDER_BASE_SEPOLIA=
# Alternatively use RPC_BASE_SEPOLIA_FORK_URL, as in kittycorn-contracts.
# RPC_BASE_SEPOLIA_FORK_URL=

# Diagnostic logs may contain RPC information. Keep disabled for normal quotes.
DEBUG_ROUTING=false
